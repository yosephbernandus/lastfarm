# Local-only backend settings. Never put these values in dist/ or browser code.
PORT=8787

# Optional TypeSafe System One adapter. Leave URL/key blank for local fallback.
# Use the full endpoint URL, normally https://api.typesafe.ai/v1/systemone.
JEV_API_URL=
JEV_API_KEY=
JEV_API_PROTOCOL=typesafe-systemone
JEV_MODEL=jev-latest

# Used only with JEV_API_PROTOCOL=generic.
JEV_API_AUTH_HEADER=Authorization
JEV_API_AUTH_PREFIX=Bearer

# Optional natural-dialogue voice. Jev/local rules remain authoritative.
DIALOGUE_PROVIDER=openai
OPENAI_API_KEY=
DIALOGUE_MODEL=gpt-5.6-luna
DIALOGUE_MAX_OUTPUT_TOKENS=96
# Optional OpenAI-compatible API base; only change when intentionally self-hosting.
OPENAI_BASE_URL=https://api.openai.com/v1
